# EAS receives source and diagnostics; only the explicitly staged Gemma bundle may include weights.
/*
!/mobile
!/scripts
**/node_modules/
**/.git/
**/.expo/
**/.eas-output/
**/build/
!/mobile/.eas/build
**/Pods/
**/DerivedData/
**/vendor/
**/coverage/
**/.gradle/
**/.idea/
**/xcuserdata/
**/*.aimodel/
!/mobile/ios/Assist/NumericalProbe/RMSNormProbe.aimodel
!/mobile/ios/Assist/NumericalProbe/RMSNormProbe.aimodel/**
!/mobile/ios/Assist/NumericalProbeFP32/RMSNormProbe.aimodel
!/mobile/ios/Assist/NumericalProbeFP32/RMSNormProbe.aimodel/**
!/mobile/ios/Assist/BundledModels/Gemma
!/mobile/ios/Assist/BundledModels/Gemma/**
# Keep secrets and unconverted checkpoints excluded even inside the staged bundle.
**/.xcode.env.local
**/.env
**/.env.*
**/credentials.json
**/.npmrc
**/*.p12
**/*.p8
**/*.pem
**/*.key
**/*.mobileprovision
**/*.keystore
**/*.ipa
**/*.ips
**/*.jsbundle
**/*.mlmodelc/
**/*.mlpackage/
**/*.safetensors
!/mobile/ios/Assist/BundledModels/Gemma/*_ple.safetensors
**/*.gguf
**/models/
**/artifacts/
**/npm-debug.log
**/.DS_Store
