{
  "cli": {
    "version": "24.14.0",
    "requireCommit": true,
    "appVersionSource": "local"
  },
  "build": {
    "testflight": {
      "extends": "preview",
      "distribution": "store",
      "environment": "production",
      "env": {
        "ASSIST_REQUIRE_BUNDLED_GEMMA": "0"
      }
    },
    "preview": {
      "node": "22.22.1",
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "ASSIST_REQUIRE_BUNDLED_GEMMA": "1"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1",
        "resourceClass": "medium",
        "scheme": "Assist",
        "buildConfiguration": "Release",
        "credentialsSource": "remote"
      }
    },
    "ios-compile": {
      "node": "22.22.1",
      "environment": "preview",
      "withoutCredentials": true,
      "ios": {
        "config": "ios-compile.yml",
        "image": "macos-tahoe-26.6-xcode-27.1",
        "resourceClass": "medium",
        "scheme": "Assist",
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6823046171"
      }
    }
  }
}
