{
  "name": "Assist",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "eas-build-pre-install": "if [ \"$EAS_BUILD_PLATFORM\" = \"ios\" ]; then python3 ../scripts/test-ios-launch.py && node ../scripts/bundle-gemma.mjs --verify --if-present && bash ../scripts/preflight-ios.sh && bash ../scripts/check-voice-callbacks.sh && bash ../scripts/check-voice-input.sh && bash ../scripts/check-voice-speech-queue.sh && bash ../scripts/check-voice-duplex.sh && bash ../scripts/check-speech-voices.sh && bash ../scripts/check-fluid-voice.sh && bash ../scripts/check-advanced-voice-files.sh && bash ../scripts/check-fluid-sdk.sh; fi",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "preview": "vite --config preview/vite.config.mjs",
    "preview:build": "vite build --config preview/vite.config.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "codegen:ios": "node node_modules/react-native/scripts/generate-codegen-artifacts.js --path . --outputPath ios/ --targetPlatform ios",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run codegen:ios"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-updates": "~58.0.17",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/eslint-config": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@react-native/metro-config": "^0.88.0",
    "@react-native/typescript-config": "^0.88.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^8.19.0",
    "jest": "~30.5.2",
    "prettier": "2.8.8",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.4",
    "react-test-renderer": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "codegenConfig": {
    "name": "AssistSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "ios": {
      "modules": {
        "NativeAssist": {
          "className": "RCTNativeAssist"
        }
      }
    }
  }
}
